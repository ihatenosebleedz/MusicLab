# musiclab-backend environment configuration
# Copy to .env and fill in real values before starting.

# --- Server ---
PORT=3000
HOST=0.0.0.0

# --- Auth ---
# Path to the bearer token secret file (auto-generated by `npm run generate-token`)
TOKEN_FILE=./data/token.secret

# --- amdl ---
AMDL_CWD=/home/nbz/apple-music-downloader
AMDL_BIN=./amdl

# --- Navidrome / OpenSubsonic ---
NAVIDROME_URL=http://127.0.0.1:4533
NAVIDROME_USER=nbz
# Navidrome password (plain text — converted to MD5 token+salt per OpenSubsonic spec at runtime)
NAVIDROME_PASS=

# --- wrapper-lite ---
WRAPPER_LITE_URL=http://127.0.0.1:12340

# --- Music folder ---
MUSIC_FOLDER=/mnt/media/Music

# --- SQLite ---
DB_PATH=./data/jobs.db
